			"timestamps": {
				"from": "00:00:23,360",
				"to": "00:00:25,360"
			},
			"offsets": {
				"from": 23360,
				"to": 25360
			},
			"text": " was something that really weighed upon me."
		},
		{
			"timestamps": {
