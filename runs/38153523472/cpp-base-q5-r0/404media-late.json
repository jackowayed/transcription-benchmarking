				"to": "00:00:32,400"
			},
			"offsets": {
				"from": 29560,
				"to": 32400
			},
			"text": " It was pretty obvious when I was in the middle of it."
		},
		{
			"timestamps": {
				"from": "00:00:32,400",
				"to": "00:00:36,900"
			},
			"offsets": {
				"from": 32400,
				"to": 36900
			},
			"text": " That was the thing that was actually the most scary for me was I was like we get one chance"
