				"from": "00:03:25,380",
				"to": "00:03:28,380"
			},
			"offsets": {
				"from": 205380,
				"to": 208380
			},
			"text": " after challenging an LED board change as hindrance."
		},
		{
			"timestamps": {
				"from": "00:03:28,380",
				"to": "00:03:31,340"
			},
			"offsets": {
				"from": 208380,
				"to": 211340
			},
			"text": " Despite finishing the rally before raising the issue,"
		},
		{
			"timestamps": {
				"from": "00:03:31,340",
				"to": "00:03:33,100"
			},
			"offsets": {
				"from": 211340,
				"to": 213100
			},
			"text": " Novak wasn't happy about the call,"
		},
		{
			"timestamps": {
				"from": "00:03:33,100",
				"to": "00:03:43,840"
			},
			"offsets": {
				"from": 213100,
				"to": 223840
			},
			"text": " but let's just take a look at what happened."
		},
		{
			"timestamps": {
				"from": "00:03:43,840",
				"to": "00:03:47,360"
			},
			"offsets": {
				"from": 223840,
				"to": 227360
			},
			"text": " That's a very good return there from Novak Jokovic."
		},
		{
			"timestamps": {
				"from": "00:03:53,380",
				"to": "00:03:54,220"
			},
			"offsets": {
				"from": 233380,
				"to": 234220
			},
			"text": " Oh, Sarif."
		},
		{
			"timestamps": {
				"from": "00:03:55,380",
				"to": "00:03:56,740"
			},
			"offsets": {
				"from": 235380,
				"to": 236740
			},
			"text": " I'm happy with something--"
		},
		{
			"timestamps": {
				"from": "00:03:56,740",
				"to": "00:04:00,100"
			},
			"offsets": {
				"from": 236740,
				"to": 240100
			},
			"text": " (INDISTINCT CHATTER)"
		},
		{
			"timestamps": {
				"from": "00:04:05,100",
				"to": "00:04:08,860"
			},
			"offsets": {
				"from": 245100,
				"to": 248860
			},
			"text": " They do change as he's just about to serve."
		},
		{
			"timestamps": {
				"from": "00:04:08,860",
				"to": "00:04:12,050"
			},
			"offsets": {
				"from": 248860,
				"to": 252050
			},
			"text": " So I think he will get the lead here."
		},
		{
			"timestamps": {
				"from": "00:04:12,050",
				"to": "00:04:15,610"
			},
			"offsets": {
				"from": 252050,
				"to": 255610
			},
			"text": " OK, so now you're telling me fine, I get it."
		},
		{
			"timestamps": {
				"from": "00:04:15,610",
				"to": "00:04:16,970"
			},
			"offsets": {
				"from": 255610,
				"to": 256970
			},
			"text": " It was about-- he was about to serve."
		},
		{
			"timestamps": {
				"from": "00:04:16,970",
				"to": "00:04:18,530"
			},
			"offsets": {
				"from": 256970,
				"to": 258530
			},
			"text": " He served."
		},
		{
			"timestamps": {
				"from": "00:04:18,530",
				"to": "00:04:20,730"
			},
			"offsets": {
				"from": 258530,
				"to": 260730
			},
			"text": " I played one shot, he played another shot,"
		},
		{
			"timestamps": {
				"from": "00:04:20,730",
				"to": "00:04:22,010"
			},
			"offsets": {
				"from": 260730,
				"to": 262010
			},
			"text": " and then he challenged."
		},
		{
			"timestamps": {
				"from": "00:04:22,010",
				"to": "00:04:23,570"
			},
			"offsets": {
				"from": 262010,
				"to": 263570
			},
			"text": " Is that OK?"
		},
		{
			"timestamps": {
				"from": "00:04:23,570",
				"to": "00:04:29,410"
			},
			"offsets": {
				"from": 263570,
				"to": 269410
			},
			"text": " One second, even he was annoyed by that change there."
		},
		{
			"timestamps": {
				"from": "00:04:29,410",
				"to": "00:04:31,730"
			},
			"offsets": {
				"from": 269410,
				"to": 271730
			},
			"text": " He would stop after the serve and he would go home."
		},
		{
			"timestamps": {
				"from": "00:04:31,730",
				"to": "00:04:33,610"
			},
			"offsets": {
				"from": 271730,
				"to": 273610
			},
			"text": " It doesn't make any sense."
		},
		{
			"timestamps": {
				"from": "00:04:33,610",
				"to": "00:04:37,370"
			},
			"offsets": {
				"from": 273610,
				"to": 277370
			},
			"text": " I mean, you miss not knowing the right direction."
		},
		{
			"timestamps": {
				"from": "00:04:37,370",
				"to": "00:04:39,290"
			},
			"offsets": {
				"from": 277370,
				"to": 279290
			},
			"text": " I didn't know it, but it challenged me."
		},
		{
			"timestamps": {
				"from": "00:04:39,290",
				"to": "00:04:41,210"
			},
			"offsets": {
				"from": 279290,
				"to": 281210
			},
			"text": " That's why I came to him and I asked him at this time."
		},
		{
			"timestamps": {
				"from": "00:04:41,210",
				"to": "00:04:43,210"
			},
			"offsets": {
				"from": 281210,
				"to": 283210
			},
			"text": " Yeah, but then you stop after the serve,"
		},
		{
			"timestamps": {
				"from": "00:04:43,210",
				"to": "00:04:45,570"
			},
			"offsets": {
				"from": 283210,
				"to": 285570
			},
			"text": " but I didn't know if that's the reason enough to challenge."
		},
		{
			"timestamps": {
				"from": "00:04:45,570",
				"to": "00:04:47,370"
			},
			"offsets": {
				"from": 285570,
				"to": 287370
			},
			"text": " That's why I love him."
		},
		{
			"timestamps": {
				"from": "00:04:47,370",
				"to": "00:04:50,290"
			},
			"offsets": {
				"from": 287370,
				"to": 290290
			},
			"text": " I mean, this must be the one of the most stupid change of rules"
		},
		{
			"timestamps": {
				"from": "00:04:50,290",
				"to": "00:04:51,850"
			},
			"offsets": {
				"from": 290290,
				"to": 291850
			},
			"text": " that I've ever heard in my life."
		},
		{
			"timestamps": {
				"from": "00:04:51,850",
				"to": "00:04:55,730"
			},
			"offsets": {
				"from": 291850,
				"to": 295730
			},
			"text": " Because he might have seized that there is a hindrance of that"
		},
		{
			"timestamps": {
				"from": "00:04:55,730",
				"to": "00:04:57,130"
			},
			"offsets": {
				"from": 295730,
				"to": 297130
			},
			"text": " shot he stops immediately."
		},
		{
			"timestamps": {
				"from": "00:04:57,130",
				"to": "00:04:59,650"
			},
			"offsets": {
				"from": 297130,
				"to": 299650
			},
			"text": " I mean, we could play a 30 shot rally"
		},
		{
			"timestamps": {
				"from": "00:04:59,650",
				"to": "00:05:00,770"
			},
			"offsets": {
				"from": 299650,
				"to": 300770
			},
			"text": " and he can lose the point."
		},
		{
			"timestamps": {
				"from": "00:05:00,770",
				"to": "00:05:04,680"
			},
			"offsets": {
				"from": 300770,
				"to": 304680
			},
			"text": " He's like, OK, I'm going to challenge now."
		},
		{
			"timestamps": {
				"from": "00:05:04,680",
				"to": "00:05:06,880"
			},
			"offsets": {
				"from": 304680,
				"to": 306880
			},
			"text": " Real quick for some-- so in February,"
		},
		{
			"timestamps": {
				"from": "00:05:06,880",
				"to": "00:05:08,080"
			},
			"offsets": {
				"from": 306880,
				"to": 308080
			},
			"text": " they essentially changed the role."
		},
		{
			"timestamps": {
				"from": "00:05:08,080",
				"to": "00:05:09,480"
			},
			"offsets": {
				"from": 308080,
				"to": 309480
			},
			"text": " Originally, it was the other way where"
		},
		{
			"timestamps": {
				"from": "00:05:09,480",
				"to": "00:05:12,720"
			},
			"offsets": {
				"from": 309480,
				"to": 312720
			},
			"text": " players had to stop the play to challenge hindrance."
		},
		{
			"timestamps": {
				"from": "00:05:12,720",
				"to": "00:05:14,440"
			},
			"offsets": {
				"from": 312720,
				"to": 314440
			},
			"text": " They changed that, apparently, in February."
		},
		{
			"timestamps": {
				"from": "00:05:14,440",
				"to": "00:05:16,160"
			},
			"offsets": {
				"from": 314440,
				"to": 316160
			},
			"text": " The current hindrance rule requesting"
		},
		{
			"timestamps": {
				"from": "00:05:16,160",
				"to": "00:05:19,560"
			},
			"offsets": {
				"from": 316160,
				"to": 319560
			},
			"text": " after the point is concluded has been implemented as a trial"
		},
		{
			"timestamps": {
				"from": "00:05:19,560",
				"to": "00:05:21,120"
			},
			"offsets": {
				"from": 319560,
				"to": 321120
			},
			"text": " and will be reviewed at the end of the season."
		},
		{
			"timestamps": {
				"from": "00:05:21,120",
				"to": "00:05:23,120"
			},
			"offsets": {
				"from": 321120,
				"to": 323120
			},
			"text": " So Novak's correct, that's not the way it used to be."
		},
		{
			"timestamps": {
				"from": "00:05:23,120",
				"to": "00:05:24,320"
			},
			"offsets": {
				"from": 323120,
				"to": 324320
			},
			"text": " It's a real change."
		},
		{
			"timestamps": {
				"from": "00:05:24,320",
				"to": "00:05:27,800"
			},
			"offsets": {
				"from": 324320,
				"to": 327800
			},
			"text": " So no, they're all right, by the way."
		},
		{
			"timestamps": {
				"from": "00:05:27,800",
				"to": "00:05:29,480"
			},
			"offsets": {
				"from": 327800,
				"to": 329480
			},
			"text": " And they disagreed in this moment."
		},
		{
			"timestamps": {
				"from": "00:05:29,480",
				"to": "00:05:31,240"
			},
			"offsets": {
				"from": 329480,
				"to": 331240
			},
			"text": " That's not a testy exchange."
		},
		{
			"timestamps": {
				"from": "00:05:31,240",
				"to": "00:05:32,160"
			},
			"offsets": {
				"from": 331240,
				"to": 332160
			},
			"text": " No, no, no, no, not at all."
		},
		{
			"timestamps": {
				"from": "00:05:32,160",
				"to": "00:05:33,120"
			},
			"offsets": {
				"from": 332160,
				"to": 333120
			},
			"text": " That's not a testy exchange."
		},
		{
			"timestamps": {
				"from": "00:05:33,120",
				"to": "00:05:35,800"
			},
			"offsets": {
				"from": 333120,
				"to": 335800
			},
			"text": " A testy exchange has some--"
		},
		{
			"timestamps": {
				"from": "00:05:35,800",
				"to": "00:05:37,640"
			},
			"offsets": {
				"from": 335800,
				"to": 337640
			},
			"text": " it's very simple."
		},
		{
			"timestamps": {
				"from": "00:05:37,640",
				"to": "00:05:39,360"
			},
			"offsets": {
				"from": 337640,
				"to": 339360
			},
			"text": " It did change."
		},
		{
			"timestamps": {
				"from": "00:05:39,360",
				"to": "00:05:42,520"
			},
			"offsets": {
				"from": 339360,
				"to": 342520
			},
			"text": " And you see that, you look at the side, you see that."
		},
		{
			"timestamps": {
				"from": "00:05:42,520",
				"to": "00:05:43,560"
			},
			"offsets": {
				"from": 342520,
				"to": 343560
			},
			"text": " You have to understand that."
		},
		{
			"timestamps": {
				"from": "00:05:43,560",
				"to": "00:05:45,440"
			},
			"offsets": {
				"from": 343560,
				"to": 345440
			},
			"text": " And that's why when people are like,"
		},
		{
			"timestamps": {
				"from": "00:05:45,440",
				"to": "00:05:47,080"
			},
			"offsets": {
				"from": 345440,
				"to": 347080
			},
			"text": " oh, we can't walk around during points."
		},
		{
			"timestamps": {
				"from": "00:05:47,080",
				"to": "00:05:49,640"
			},
			"offsets": {
				"from": 347080,
				"to": 349640
			},
			"text": " Well, it's not about the actual motion walking around."
		},
		{
			"timestamps": {
				"from": "00:05:49,640",
				"to": "00:05:54,040"
			},
			"offsets": {
				"from": 349640,
				"to": 354040
			},
			"text": " We're trying to track a ball that looks like the size of a P,"
		},
		{
			"timestamps": {
				"from": "00:05:54,040",
				"to": "00:05:55,880"
			},
			"offsets": {
				"from": 354040,
				"to": 355880
			},
			"text": " and it's going 140 miles an hour."
		},
		{
			"timestamps": {
				"from": "00:05:55,880",
				"to": "00:06:00,620"
			},
			"offsets": {
				"from": 355880,
				"to": 360620
			},
			"text": " And we have a quarter of a second to find it, track it, run."
		},
		{
			"timestamps": {
				"from": "00:06:00,620",
				"to": "00:06:03,860"
			},
			"offsets": {
				"from": 360620,
				"to": 363860
			},
			"text": " So any sort of variance changes that a little bit."
		},
		{
			"timestamps": {
				"from": "00:06:03,860",
				"to": "00:06:05,640"
			},
			"offsets": {
				"from": 363860,
				"to": 365640
			},
			"text": " I think that's what's Vary was saying."
		},
		{
			"timestamps": {
				"from": "00:06:05,640",
				"to": "00:06:08,360"
			},
			"offsets": {
				"from": 365640,
				"to": 368360
			},
			"text": " But what Sasha says also makes a lot of sense."
		},
		{
			"timestamps": {
				"from": "00:06:08,360",
				"to": "00:06:09,320"
			},
			"offsets": {
				"from": 368360,
				"to": 369320
			},
			"text": " I didn't know if I could."
		},
		{
			"timestamps": {
				"from": "00:06:09,320",
				"to": "00:06:11,680"
			},
			"offsets": {
				"from": 369320,
				"to": 371680
			},
			"text": " So I simply asked after the point."
		},
		{
			"timestamps": {
				"from": "00:06:11,680",
				"to": "00:06:13,320"
			},
			"offsets": {
				"from": 371680,
				"to": 373320
			},
			"text": " If you don't know that you can challenge something,"
		},
		{
			"timestamps": {
				"from": "00:06:13,320",
				"to": "00:06:16,120"
			},
			"offsets": {
				"from": 373320,
				"to": 376120
			},
			"text": " you wouldn't be predisposed to challenging it right away."
		},
		{
			"timestamps": {
				"from": "00:06:16,120",
				"to": "00:06:17,560"
			},
			"offsets": {
				"from": 376120,
				"to": 377560
			},
			"text": " You hit the shot, hoping you make it."
		},
		{
			"timestamps": {
				"from": "00:06:17,560",
				"to": "00:06:20,040"
			},
			"offsets": {
				"from": 377560,
				"to": 380040
			},
			"text": " And then if you miss it, you ask for basically,"
		},
		{
			"timestamps": {
				"from": "00:06:20,040",
				"to": "00:06:22,880"
			},
			"offsets": {
				"from": 380040,
				"to": 382880
			},
			"text": " Novak was saying the rule is stupid."
		},
		{
			"timestamps": {
				"from": "00:06:22,880",
				"to": "00:06:24,740"
			},
			"offsets": {
				"from": 382880,
				"to": 384740
			},
			"text": " You should have to stop."
		},
		{
			"timestamps": {
				"from": "00:06:24,740",
				"to": "00:06:25,580"
			},
			"offsets": {
				"from": 384740,
				"to": 385580
			},
			"text": " - Do it right away."
		},
		{
			"timestamps": {
				"from": "00:06:25,580",
				"to": "00:06:26,560"
			},
			"offsets": {
				"from": 385580,
				"to": 386560
			},
			"text": " - I don't disagree with him."
		},
		{
			"timestamps": {
				"from": "00:06:26,560",
				"to": "00:06:27,400"
			},
			"offsets": {
				"from": 386560,
				"to": 387400
			},
			"text": " - Yeah."
		},
		{
			"timestamps": {
				"from": "00:06:27,400",
				"to": "00:06:28,240"
			},
			"offsets": {
				"from": 387400,
				"to": 388240
			},
			"text": " - Right?"
		},
		{
			"timestamps": {
				"from": "00:06:28,240",
				"to": "00:06:33,240"
			},
			"offsets": {
				"from": 388240,
				"to": 393240
			},
			"text": " And Novak was making a judgment on the actual ruling."
		},
		{
			"timestamps": {
				"from": "00:06:33,640",
				"to": "00:06:37,960"
			},
			"offsets": {
				"from": 393640,
				"to": 397960
			},
			"text": " And it seemed like Sasha was looking for clarification"
		},
		{
			"timestamps": {
				"from": "00:06:37,960",
